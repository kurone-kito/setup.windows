{
  "$schema": "https://kurone-kito.github.io/idd-skill/schemas/policy.schema.json",
  "iddVersion": "0.11.0",
  "markerPrefix": "setup-windows",
  "mergePolicy": "fully_autonomous_merge",
  "mergePolicyAck": "fully_autonomous_merge",
  "reviewPolicy": "copilot-advisory",
  "threadResolutionPolicy": "fast-agent-resolve",
  "authoringLanguage": "en",
  "provider": "github",
  "claimTiming": {
    "staleAge": "PT12H",
    "heartbeatInterval": "PT6H"
  },
  "trustedMarkerActors": ["kurone-kito", "github-actions[bot]"],
  "labels": {
    "untrustedLabelerLogins": ["coderabbitai[bot]", "reviewpad[bot]"]
  },
  "advisoryBotLogins": [
    "copilot-pull-request-reviewer[bot]",
    "coderabbitai[bot]"
  ],
  "workshop": {
    "exampleRepository": ""
  },
  "commands": {
    "install-deps": "true",
    "fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\"",
    "pre-push-validate": "npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress && pwsh -c \"Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit\" && pwsh -c \"Invoke-Pester -Path ./tests/powershell -CI\"",
    "post-fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress && pwsh -c \"Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit\" && pwsh -c \"Invoke-Pester -Path ./tests/powershell -CI\""
  },
  "helperRuntime": {
    "profile": "ephemeral-npx",
    "packageSpec": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/1f90787ebf4021673ce6e5eb69741df331fd2037"
  },
  "issueScope": "roadmap-first",
  "orphanFirstPolicy": "none",
  "skipIssueAuthorApprovalGate": true,
  "maintainerApprovalActorPolicy": "owners-and-maintainers-only",
  "advisoryWait": {
    "convergenceScope": "all-prs"
  },
  "advisoryConvergence": {
    "copilotReviewPollMaxWait": "PT60S"
  },
  "ciWait": {
    "runningTimeout": "PT10M",
    "generationTimeout": "PT10M",
    "rerunPolicy": "rerun-once"
  },
  "autopilotSuitability": {
    "floor": 3
  },
  "worktreeGuard": {
    "enabled": true
  },
  "ciGate": {
    "externalChecks": {
      "waivable": [{ "selector": "idd-advisory-convergence" }]
    },
    "externalCheckWaivers": { "mode": "maintainer-authorized" },
    "trustEmptyProtectionReads": true
  },
  "providerHealth": {
    "minCorroboratingPrs": 2,
    "samplingWindow": "PT24H"
  },
  "localValidationEvidence": {
    "maxAge": "PT4H"
  },
  "upstreamEscalation": {
    "enabled": true
  },
  "critiqueLoop": {
    "delegate": {
      "command": "npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress && pwsh -c \"Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit\" && pwsh -c \"Invoke-Pester -Path ./tests/powershell -CI\"",
      "mode": "combined"
    }
  },
  "issueAuthoring": {
    "journalIssue": "kurone-kito/setup.windows#175"
  }
}
