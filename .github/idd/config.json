{
  "$schema": "https://kurone-kito.github.io/idd-skill/schemas/policy.schema.json",
  "iddVersion": "0.14.0",
  "markerPrefix": "setup-windows",
  "authoringLanguage": "en",
  "developmentBranch": "master",
  "mergePolicy": "fully_autonomous_merge",
  "mergePolicyAck": "fully_autonomous_merge",
  "reviewPolicy": "copilot-advisory",
  "threadResolutionPolicy": "fast-agent-resolve",
  "claimTiming": {
    "staleAge": "PT24H",
    "heartbeatInterval": "PT12H"
  },
  "trustedMarkerActors": [
    "kurone-kito",
    "github-actions[bot]"
  ],
  "labels": {
    "untrustedLabelerLogins": [
      "coderabbitai[bot]",
      "reviewpad[bot]"
    ]
  },
  "advisoryBotLogins": [
    "coderabbitai[bot]",
    "chatgpt-codex-connector[bot]"
  ],
  "workshop": {
    "exampleRepository": "kurone-kito/vrc-event-calendar"
  },
  "commands": {
    "install-deps": "true",
    "fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\"",
    "pre-push-validate": "npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress && pwsh -c \"Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit\" && pwsh -c \"Invoke-Pester -Path ./tests/powershell -CI\"",
    "post-fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress && pwsh -c \"Invoke-ScriptAnalyzer -Path . -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 -EnableExit\" && pwsh -c \"Invoke-Pester -Path ./tests/powershell -CI\""
  },
  "helperRuntime": {
    "profile": "ephemeral-npx",
    "packageSpec": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/ae16f497434a5023dfaa28f965fc2af92ebf055d"
  },
  "issueScope": "roadmap-first",
  "orphanFirstPolicy": "none",
  "maintainerApprovalActorPolicy": "owners-and-maintainers-only",
  "issueAuthoring": {
    "journalIssue": "kurone-kito/setup.windows#175"
  },
  "advisoryWait": {
    "convergenceScope": "idd-claimed",
    "convergenceDeadline": "PT9H",
    "secondaryBotLogin": "coderabbitai[bot]",
    "secondaryQuietWindow": "PT1H"
  },
  "discover": {
    "selectionDesync": "session-offset"
  },
  "critiqueLoop": {
    "deferAfterRounds": 5,
    "deferByUrgency": "severity-tiered",
    "telemetryHook": {
      "command": "idd-critique-telemetry"
    },
    "delegate": {
      "command": "node .github/idd/critique-delegate.mjs",
      "mode": "combined"
    }
  },
  "forcedHandoff": {
    "mode": "human-gated",
    "authorityPolicy": "owners-and-maintainers-only"
  },
  "autopilotSuitability": {
    "floor": 3
  },
  "worktreeGuard": {
    "enabled": true
  },
  "githubApi": {
    "readCache": {
      "enabled": true
    },
    "loadControl": {
      "enabled": true,
      "maxConcurrent": 4
    }
  },
  "upstreamEscalation": {
    "enabled": true
  },
  "ciGate": {
    "trustEmptyProtectionReads": true,
    "externalChecks": {
      "waivable": [
        {
          "selector": "idd-advisory-convergence",
          "matchMode": "exact"
        }
      ]
    },
    "externalCheckWaivers": {
      "mode": "maintainer-authorized",
      "authorityPolicy": "owners-and-maintainers-only",
      "maxValidity": "PT24H"
    }
  }
}
